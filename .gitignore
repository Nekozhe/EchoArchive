# ============================================
# HarmonyOS / DevEco Studio 忽略规则
# 合并版：DevEco 模板规则 + 签名/打包/系统文件
# ============================================

# ---- 依赖（由 ohpm 重新安装，不要提交） ----
/node_modules
/oh_modules
**/oh_modules

# ---- 构建产物（由 hvigor 重新生成，体积大） ----
**/build
/.hvigor
**/.hvigor
.cxx
**/.cxx
**/.preview
**/.test
/.appanalyzer
/.hvigor-cache

# ---- IDE 与本机配置（含个人绝对路径） ----
/.idea
**/.idea
*.iml
/local.properties

# ---- C/C++ 工具链配置（启用 NAPI 时生成） ----
/.clangd
/.clang-format
/.clang-tidy

# ---- 签名材料（严禁提交：泄露后他人可伪造你的应用） ----
*.p12
*.cer
*.p7b
*.csr
/signature
**/signature

# ---- 打包产物 ----
*.hap
*.hsp
*.har

# ---- 系统与日志 ----
.DS_Store
Thumbs.db
*.log